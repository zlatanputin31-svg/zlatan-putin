rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.examType in ['WAEC', 'JAMB', 'NECO', 'General']
        && (data.level == null || data.level in ['Beginner', 'Intermediate', 'Advanced'])
        && data.keys().hasAll(['uid', 'examType'])
        && data.keys().size() <= 7;
    }

    function isValidQuestionLog(data) {
      return data.questionText is string && data.questionText.size() < 5000
        && data.subject is string && data.subject.size() < 100
        && data.solution is string && data.solution.size() < 10000
        && data.timestamp == request.time
        && data.keys().hasAll(['questionText', 'subject', 'solution', 'timestamp']);
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) 
        && isValidUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid; // uid is immutable

      match /history/{questionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuestionLog(request.resource.data);
      }

      match /stats/{statId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow write: if isOwner(userId); // Stats are often updated incrementally
      }
    }
  }
}
